{
  "functions": {
    "source": "functions",
    "predeploy": ["node scripts/copy-canon-bundle.js"]
  },
  "firestore": {
    "rules": "sbd-network/firestore.rules",
    "indexes": "sbd-network/firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "main",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "functions/**",
        "vendor/**",
        "logs/**",
        "momo/**",
        "stripe/**",
        "*.md",
        "*.rb",
        "*.sh",
        "*.sql",
        "Gemfile*",
        "Procfile",
        "*.yaml",
        "*.yml"
      ],
      "headers": [
        {
          "source": "service-worker.js",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
            { "key": "Service-Worker-Allowed", "value": "/" }
          ]
        },
        {
          "source": "ambassador-sw.js",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
            { "key": "Service-Worker-Allowed", "value": "/" }
          ]
        },
        {
          "source": "ambassador-sw-v2.js",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
            { "key": "Service-Worker-Allowed", "value": "/ambassador/" }
          ]
        },
        {
          "source": "manifest.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.json",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ],
      "cleanUrls": true,
      "trailingSlash": false
    },
    {
      "target": "marriageducation",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "functions/**",
        "vendor/**",
        "logs/**",
        "momo/**",
        "stripe/**",
        "*.md",
        "*.rb",
        "*.sh",
        "*.sql",
        "Gemfile*",
        "Procfile",
        "*.yaml",
        "*.yml"
      ],
      "headers": [
        {
          "source": "service-worker.js",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
            { "key": "Service-Worker-Allowed", "value": "/" }
          ]
        },
        {
          "source": "ambassador-sw.js",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
            { "key": "Service-Worker-Allowed", "value": "/" }
          ]
        },
        {
          "source": "ambassador-sw-v2.js",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
            { "key": "Service-Worker-Allowed", "value": "/ambassador/" }
          ]
        },
        {
          "source": "manifest.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.json",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ],
      "cleanUrls": true,
      "trailingSlash": false
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}
