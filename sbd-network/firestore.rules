rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection
    match /users/{userId} {
      // Anyone authenticated can read all user profiles
      allow read: if request.auth != null;
      
      // Users can create and update their own document
      allow create, update: if request.auth != null && request.auth.uid == userId;
      
      // Admins can update any user (for managing groups, roles, etc.)
      allow update: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Only admins can delete users
      allow delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Groups collection
    match /groups/{groupId} {
      // Anyone authenticated can read groups
      allow read: if request.auth != null;
      // Only admins can create/update/delete groups
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Boards collection
    match /boards/{boardId} {
      // Anyone authenticated can read all boards
      allow read: if request.auth != null;
      // Only admins can create/update/delete boards
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Posts collection
    match /posts/{postId} {
      // Anyone authenticated can read posts
      allow read: if request.auth != null;
      // Anyone authenticated can create posts
      allow create: if request.auth != null;
      // Authors can update/delete their own posts, OR admins can delete any post
      allow update, delete: if request.auth != null && 
        (request.auth.uid == resource.data.authorId || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Comments collection
    match /comments/{commentId} {
      // Anyone authenticated can read comments
      allow read: if request.auth != null;
      // Anyone authenticated can create comments
      allow create: if request.auth != null;
      // Authors can delete their own comments, OR admins can delete any comment
      allow delete: if request.auth != null && 
        (request.auth.uid == resource.data.authorId || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
  }
}
