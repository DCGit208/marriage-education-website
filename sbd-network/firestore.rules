rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection
    match /users/{userId} {
      // Anyone authenticated can read all user profiles
      allow read: if request.auth != null;
      
      // Users can create and update their own document
      allow create, update: if request.auth != null && request.auth.uid == userId;
      
      // Admins can update any user (for managing groups, roles, etc.)
      allow update: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Only admins can delete users
      allow delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Groups collection
    match /groups/{groupId} {
      // Anyone authenticated can read groups
      allow read: if request.auth != null;
      // Only admins can create/update/delete groups
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Boards collection
    match /boards/{boardId} {
      // Anyone authenticated can read all boards
      allow read: if request.auth != null;
      // Only admins can create or delete boards
      allow create, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      // Any member can stamp lastPostAt/lastPostPreview after posting or commenting;
      // admins can update any field
      allow update: if request.auth != null && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastPostAt', 'lastPostPreview']) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    
    // Posts collection — any member can create or comment; only author/admin can fully edit/delete
    match /posts/{postId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      // Any member can update commentCount or reactions; authors/admins can update anything
      allow update: if request.auth != null && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) ||
        request.auth.uid == resource.data.authorId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.authorId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Comments collection — any member can read, create; only author/admin can edit/delete
    match /comments/{commentId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) ||
        request.auth.uid == resource.data.authorId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.authorId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Conversations collection (DMs)
    match /conversations/{convId} {
      // Participants can read their own conversations
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.participantIds;
      // Any authenticated user can create a new conversation
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participantIds;
      // Participants can update (lastMessage, lastRead, etc.)
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participantIds;

      // Messages subcollection
      match /messages/{messageId} {
        // Participants of the parent conversation can read messages
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        // Participants can send messages
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds &&
          request.auth.uid == request.resource.data.senderId;
        // Sender or admin can soft-delete; any participant can toggle reactions; sender can edit text
        allow update: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds &&
          (
            // Soft-delete: sender OR admin can mark message deleted (clears all media fields)
            (
              (request.auth.uid == resource.data.senderId ||
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['deleted','text','imageUrl','videoUrl','audioUrl','edited'])
            ) ||
            // Reactions: any participant
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          );
        allow delete: if false;
      }
    }

    // Notifications collection
    match /notifications/{notifId} {
      // Users can read their own notifications (rule phrased to allow userId query)
      allow read: if request.auth != null &&
        (resource == null || request.auth.uid == resource.data.userId);
      // Any authenticated user can create notifications (for posting/commenting)
      allow create: if request.auth != null;
      // Users can mark their own notifications as read
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      // Admins can delete notifications
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
