rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════════
    // Communication Engine V2 (CE2) — isolated from legacy /conversations
    // ════════════════════════════════════════════════════════════
    function ce2UserDataOrNull(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data
        : null;
    }
    function ce2IsAdmin(ud) {
      return ud != null && ud.role == 'admin';
    }
    // Numeric rank: foundation/free → 0, premium → 1, elite → 2; admin acts as elite+
    function ce2TierRank(ud) {
      return ud != null && ce2IsAdmin(ud) ? 3
        : ud != null && ud.tier == 'elite' ? 2
        : ud != null && ud.tier == 'premium' ? 1
        : 0;
    }
    function ce2RequiredTierRank(t) {
      return t == 'elite' ? 2
        : t == 'premium' ? 1
        : 0;
    }
    function ce2FormationLevel(ud) {
      return ud != null && ud.formationLevel is int ? ud.formationLevel : 0;
    }
    function ce2IsMentor(ud) {
      return ud != null && ud.mentor == true;
    }
    // Lower → higher DM: blocked unless receiver is mentor (or admin involved handled by rank)
    function ce2CanOpenDirectBetween(senderUid, receiverUid) {
      let s = ce2UserDataOrNull(senderUid);
      let r = ce2UserDataOrNull(receiverUid);
      return s != null && r != null
        && (ce2TierRank(s) >= ce2TierRank(r) || ce2IsMentor(r) || ce2IsAdmin(s));
    }
    function ce2GroupFormationMin(gdata) {
      return gdata != null && gdata.formationMinLevel is int ? gdata.formationMinLevel : 0;
    }
    function ce2UserMeetsGroupFormation(ud, gdata) {
      return ce2FormationLevel(ud) >= ce2GroupFormationMin(gdata);
    }
    function ce2UserMeetsGroupTier(ud, gdata) {
      return ce2TierRank(ud) >= ce2RequiredTierRank(gdata.requiredTier);
    }
    function ce2IsGroupMember(groupId, uid) {
      return exists(/databases/$(database)/documents/communicationGroups/$(groupId)/members/$(uid));
    }
    function ce2DirectOtherUid(participants, selfUid) {
      return participants[0] == selfUid ? participants[1] : participants[0];
    }
    // Classification visibility (read): user effective rank must clear bar; mentor label only for mentors
    function ce2ClassRank(c) {
      return c == 'public' ? 0
        : c == 'foundation' ? 0
        : c == 'premium' ? 1
        : c == 'elite' ? 2
        : c == 'mentor' ? 4
        : 99;
    }
    function ce2IsRequestTime(field) {
      return field == request.time;
    }
    function ce2MessageClassification(classification) {
      return classification is string ? classification : 'public';
    }
    function ce2CanReadMessageClassification(ud, classification) {
      let c = ce2MessageClassification(classification);
      return ce2IsAdmin(ud)
        || c == 'public'
        || (c == 'mentor' && ce2IsMentor(ud))
        || (c != 'mentor' && ce2TierRank(ud) >= ce2ClassRank(c));
    }

    // ============================================================
    // MARRIAGE EDUCATION SITE COLLECTIONS (marriageducation.com)
    // ============================================================

    // Courses - Public read, TESTING: allow public write for enrollment updates
    match /courses/{courseId} {
      allow read: if true;
      allow write: if true; // TESTING ONLY
    }
    
    // Enrollments - TESTING: Allow public write for testing enrollment creation
    match /enrollments/{enrollmentId} {
      allow read: if true; // TESTING ONLY
      allow write: if true; // TESTING ONLY
    }
    
    // Reflections - Students can read/write their own
    match /reflections/{reflectionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Sales records - Allow public read for dashboard, admin write
    match /sales/{saleId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
      allow create: if true;
    }
    
    // Ambassadors - Public can register and read, update own progress
    match /ambassadors/{ambassadorId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // School Progress - Ambassadors can read/write their own progress
    match /school_progress/{progressId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ambassadorId;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.ambassadorId;
      allow create: if true;
    }
    
    // Advocacy Training - Ambassadors can read/write their own training data
    match /advocacy_training/{trainingId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ambassadorId;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.ambassadorId;
      allow create: if true;
    }
    
    // Deployment Log - Ambassadors can create and read their own deployments
    match /deployment_log/{deploymentId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ambassadorId;
      allow create: if true;
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Regional Directors - Public read for testing dashboards
    match /regional_directors/{rdCode} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Pending Payments - Public read/write for admin dashboard
    match /pending_payments/{paymentRef} {
      allow read: if true;
      allow update, delete: if true;
      allow create: if true;
    }
    
    // Referral Codes - Public read/create, admin update/delete
    match /referral_codes/{referralCode} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Admin Notifications - Public read/write for admin dashboard
    match /admin_notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Notifications - Public read/create for ambassador dashboard
    match /notifications/{notifId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Contests - Public read for leaderboards
    match /contests/{contestId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Badges - Public read for achievement display
    match /badges/{badgeId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Settings - Public read for app configuration
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Announcements - Public read for ambassador dashboard
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Ambassador Registrations - Public create, admin read/write
    match /ambassador_registrations/{regId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create: if true;
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Chatbot Analytics - Public create, admin read
    match /chatbot_analytics/{analyticsId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create: if true;
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Chatbot Learning - Public read/write for AI learning
    match /chatbot_learning/{learningId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Corporate Inquiries - Public create, admin read/write
    match /corporate_inquiries/{inquiryId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create: if true;
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // User Progress - Students can read/write their own progress
    match /userProgress/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow create: if true;
    }

    // Progress tracking (marriage education)
    match /progress/{progressId} {
      allow read: if true;
      allow write: if true;
    }

    // ============================================================
    // SBD NETWORK COLLECTIONS (sbd-network.web.app)
    // ============================================================

    // Schools (Phase 0 - Formation System)
    match /schools/{schoolId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Courses (Phase 0 - Updated for Formation System)
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Modules (Phase 0 - Course Content)
    match /modules/{moduleId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Products (Phase 0 - MV House)
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users (sbd-network profiles)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Groups
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Modules
    match /modules/{moduleId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Assignments
    match /assignments/{assignmentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Boards
    match /boards/{boardId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update: if request.auth != null && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastActivityAt',
          'lastPostAt',
          'lastPostPreview',
          'postsCount',
          'commentsCount',
          'likesCount',
          'activity24h',
          'activeUsers24h',
          'rankScore',
          'updatedAt'
        ]) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    
    // Posts
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) ||
        request.auth.uid == resource.data.authorId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.authorId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Comments
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) ||
        request.auth.uid == resource.data.authorId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.authorId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Conversations (DMs)
    match /conversations/{convId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participantIds;
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds &&
          request.auth.uid == request.resource.data.senderId;
        allow update: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds &&
          (
            (
              (request.auth.uid == resource.data.senderId ||
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['deleted','text','imageUrl','videoUrl','audioUrl','edited'])
            ) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          );
        allow delete: if false;
      }
    }

    // Stories
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.authorId;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.authorId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy'])
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.authorId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Schools (sbd-network course catalog)
    match /schools/{schoolId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Quizzes
    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Certificates
    match /certificates/{certId} {
      allow read: if request.auth != null &&
        (resource == null || request.auth.uid == resource.data.userId);
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Submissions
    match /submissions/{submissionId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Orders
    match /orders/{orderId} {
      allow read: if request.auth != null &&
        (resource == null || request.auth.uid == resource.data.userId);
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Wardrobes — subcollection under users (legacy path)
    match /users/{userId}/wardrobes/{context} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Wardrobes — top-level collection (mv-house.js v247 path: wardrobes/{uid}/items/{itemId})
    match /wardrobes/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /items/{itemId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid &&
          request.resource.data.savedAt is timestamp;
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null && request.auth.uid == uid &&
          // Only allow updating note and a3Ratings fields — no structural changes
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['note', 'a3Ratings']);
      }
    }

    // MV Guidance — A3 expression content, admin-managed, authenticated read
    match /mv_guidance/{categoryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Notification Settings (subcollection: users/{uid}/settings/notifications)
    match /users/{userId}/settings/{doc} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Upgrade Events — analytics (v248)
    match /upgradeEvents/{eventId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update, delete: if false;
    }

    // ── COVENANT MATCHING SYSTEM (v249) ─────────────────────────────────

    // Matches — created exclusively by Cloud Functions
    match /matches/{matchId} {
      allow read: if request.auth != null && (
        resource.data.userA == request.auth.uid ||
        resource.data.userB == request.auth.uid
      );
      allow create: if false;  // Cloud Function only
      allow update: if request.auth != null && (
        resource.data.userA == request.auth.uid ||
        resource.data.userB == request.auth.uid
      );
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      // Match conversation messages
      match /messages/{msgId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/matches/$(matchId)).data.userA == request.auth.uid ||
          get(/databases/$(database)/documents/matches/$(matchId)).data.userB == request.auth.uid
        );
        allow create: if request.auth != null && (
          get(/databases/$(database)/documents/matches/$(matchId)).data.userA == request.auth.uid ||
          get(/databases/$(database)/documents/matches/$(matchId)).data.userB == request.auth.uid
        ) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.message is string &&
          request.resource.data.message.size() <= 1000;
        allow update, delete: if false;
      }
    }

    // Connection Requests — user-initiated interest signals
    match /connectionRequests/{reqId} {
      allow read: if request.auth != null && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if request.auth != null &&
        request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.toUid == request.auth.uid;  // recipient can accept/decline
      allow delete: if request.auth != null &&
        resource.data.fromUid == request.auth.uid;
    }

    // Match Requests — formal match proposals
    match /matchRequests/{reqId} {
      allow read: if request.auth != null && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if request.auth != null &&
        request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.toUid == request.auth.uid;
      allow delete: if false;
    }

    // Coaching Requests — submitted to admin/coach queue
    match /coachingRequests/{reqId} {
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow delete: if false;
    }

    // Marriage Track — formation progress records
    match /marriageTrack/{trackId} {
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow create, update: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Reports — user-submitted safety reports
    match /reports/{reportId} {
      allow create: if request.auth != null &&
        request.resource.data.reportedBy == request.auth.uid &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() <= 500;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow delete: if false;
    }

    // Blocked Users — user-initiated blocks
    match /blockedUsers/{blockId} {
      allow create: if request.auth != null &&
        request.resource.data.blockedBy == request.auth.uid;
      allow read: if request.auth != null &&
        resource.data.blockedBy == request.auth.uid;
      allow delete: if request.auth != null &&
        resource.data.blockedBy == request.auth.uid;
      allow update: if false;
    }

    // ── Communication Engine V2 (isolated; legacy /conversations untouched) ──
    match /communicationGroups/{groupId} {
      // list: admin may load all in panel; others only docs their tier can discover
      allow list: if request.auth != null && (
        ce2IsAdmin(ce2UserDataOrNull(request.auth.uid)) ||
        ce2UserMeetsGroupTier(ce2UserDataOrNull(request.auth.uid), resource.data)
      );
      allow get: if request.auth != null && (
        ce2UserMeetsGroupTier(ce2UserDataOrNull(request.auth.uid), resource.data) ||
        ce2IsGroupMember(groupId, request.auth.uid) ||
        ce2IsAdmin(ce2UserDataOrNull(request.auth.uid))
      );
      allow create: if request.auth != null &&
        ce2IsAdmin(ce2UserDataOrNull(request.auth.uid)) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'name', 'requiredTier', 'mentorLed', 'allowCrossTier', 'createdBy'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.requiredTier is string;
      allow update: if request.auth != null && (
        ce2IsAdmin(ce2UserDataOrNull(request.auth.uid)) ||
        (
          ce2IsGroupMember(groupId, request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'lastPreview'])
        )
      );
      allow delete: if request.auth != null &&
        ce2IsAdmin(ce2UserDataOrNull(request.auth.uid));

      match /members/{memberId} {
        allow read: if request.auth != null && (
          request.auth.uid == memberId ||
          ce2IsGroupMember(groupId, request.auth.uid) ||
          ce2IsAdmin(ce2UserDataOrNull(request.auth.uid))
        );
        allow create: if request.auth != null &&
          request.auth.uid == memberId &&
          (
            ce2IsAdmin(ce2UserDataOrNull(request.auth.uid)) ||
            ce2UserMeetsGroupTier(
              ce2UserDataOrNull(request.auth.uid),
              get(/databases/$(database)/documents/communicationGroups/$(groupId)).data
            )
          );
        allow update: if request.auth != null &&
          request.auth.uid == memberId &&
          (
            ce2IsAdmin(ce2UserDataOrNull(request.auth.uid)) ||
            ce2UserMeetsGroupTier(
              ce2UserDataOrNull(request.auth.uid),
              get(/databases/$(database)/documents/communicationGroups/$(groupId)).data
            )
          );
        allow delete: if request.auth != null && (
          request.auth.uid == memberId ||
          ce2IsAdmin(ce2UserDataOrNull(request.auth.uid))
        );
      }

      match /ce2_messages/{messageId} {
        allow read: if request.auth != null &&
          (
            ce2IsAdmin(ce2UserDataOrNull(request.auth.uid)) ||
            (
              ce2IsGroupMember(groupId, request.auth.uid) &&
              ce2CanReadMessageClassification(ce2UserDataOrNull(request.auth.uid), resource.data.classification)
            )
          );
        allow create: if request.auth != null &&
          (
            ce2IsGroupMember(groupId, request.auth.uid) ||
            ce2IsAdmin(ce2UserDataOrNull(request.auth.uid))
          ) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.keys().hasAll([
            'conversationId', 'senderId', 'tier', 'classification', 'shareable', 'content', 'createdAt'
          ]) &&
          request.resource.data.conversationId == groupId &&
          request.resource.data.tier is string &&
          request.resource.data.classification is string &&
          request.resource.data.shareable is bool &&
          request.resource.data.content is string &&
          request.resource.data.content.size() <= 8000 &&
          request.resource.data.createdAt is timestamp &&
          ce2CanReadMessageClassification(ce2UserDataOrNull(request.auth.uid), request.resource.data.classification);
        allow update: if request.auth != null &&
          ce2IsGroupMember(groupId, request.auth.uid) &&
          resource.data.senderId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'editedAt']);
        allow delete: if false;
      }
    }

    match /ce2_conversations/{convId} {
      allow list: if request.auth != null &&
        request.auth.uid in resource.data.participantIds;
      allow get: if request.auth != null &&
        request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null &&
        request.resource.data.participantIds is list &&
        request.resource.data.participantIds.size() == 2 &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.keys().hasAll(['participantIds', 'type', 'createdAt']) &&
        request.resource.data.type == 'direct' &&
        ce2IsRequestTime(request.resource.data.createdAt) &&
        ce2CanOpenDirectBetween(
          request.auth.uid,
          ce2DirectOtherUid(request.resource.data.participantIds, request.auth.uid)
        );
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participantIds &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'lastPreview']);
      allow delete: if false;

      match /ce2_messages/{messageId} {
        allow read: if request.auth != null &&
          exists(/databases/$(database)/documents/ce2_conversations/$(convId)) &&
          request.auth.uid in get(/databases/$(database)/documents/ce2_conversations/$(convId)).data.participantIds &&
          ce2CanReadMessageClassification(ce2UserDataOrNull(request.auth.uid), resource.data.classification);
        allow create: if request.auth != null &&
          exists(/databases/$(database)/documents/ce2_conversations/$(convId)) &&
          request.auth.uid in get(/databases/$(database)/documents/ce2_conversations/$(convId)).data.participantIds &&
          request.auth.uid == request.resource.data.senderId &&
          request.resource.data.keys().hasAll([
            'conversationId', 'senderId', 'receiverId', 'tier', 'classification', 'shareable', 'content', 'createdAt'
          ]) &&
          request.resource.data.conversationId == convId &&
          request.resource.data.receiverId is string &&
          request.resource.data.tier is string &&
          request.resource.data.classification is string &&
          request.resource.data.shareable is bool &&
          request.resource.data.content is string &&
          request.resource.data.content.size() <= 8000 &&
          request.resource.data.createdAt is timestamp &&
          ce2CanReadMessageClassification(ce2UserDataOrNull(request.auth.uid), request.resource.data.classification);
        allow update: if request.auth != null &&
          exists(/databases/$(database)/documents/ce2_conversations/$(convId)) &&
          request.auth.uid in get(/databases/$(database)/documents/ce2_conversations/$(convId)).data.participantIds &&
          resource.data.senderId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'editedAt']);
        allow delete: if false;
      }
    }

    // Admin Settings — scoring weights, scoring thresholds, flags
    match /admin/{section} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      match /{subsection}/{docId} {
        allow read: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
    }
  }
}
