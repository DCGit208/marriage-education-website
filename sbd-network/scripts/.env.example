# Cloudflare R2 credentials for upload-to-r2.js
# Fill in all 5 values then run: node scripts/upload-to-r2.js --dry-run

# From: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_KEY=your_r2_secret_access_key_here

# The bucket you created in R2 (recommended name: sbd-media)
R2_BUCKET=sbd-media

# Public URL for the bucket.
# Option A: Enable "Public access" on the bucket → use the r2.dev URL shown
#   e.g. https://pub-abc123.r2.dev
# Option B: Add a custom domain in R2 bucket settings
#   e.g. https://media.yourdomain.com
R2_PUBLIC_URL=https://pub-REPLACE_ME.r2.dev
