{
  "name": "sbd-network",
  "version": "1.0.0",
  "description": "SBD Network — build pipeline",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "validate": "node scripts/validate-public-js.js && node scripts/verify-guest-ux.js && node scripts/test-ce2-board-return.js && node scripts/test-bottom-nav-viewport.js && node scripts/test-ce2-presence.js && node scripts/test-ce2-messenger-fixes.js && node scripts/test-ce2-elite-delivery.js && node scripts/test-ce2-message-actions.js",
    "test:bottom-nav": "node scripts/test-bottom-nav-viewport.js",
    "test:ce2-messenger": "node scripts/test-ce2-messenger-fixes.js",
    "test:ce2-elite-delivery": "node scripts/test-ce2-elite-delivery.js",
    "test:ce2-message-actions": "node scripts/test-ce2-message-actions.js",
    "test:ce2-presence": "node scripts/test-ce2-presence.js",
    "test:ce2-board-return": "node scripts/test-ce2-board-return.js",
    "test:guest-ux": "node scripts/verify-guest-ux.js",
    "test:guest-ux:browser": "playwright test --config=playwright.guest.config.js",
    "test:smoke": "playwright test browser-tests/00-auth-smoke.spec.js",
    "catalog": "node scripts/generate-shop-catalog.js",
    "deploy": "node build.js && firebase deploy --only hosting",
    "deploy:all": "node build.js && firebase deploy --only hosting,firestore:rules",
    "migrate": "node migrate.js"
  }
}
