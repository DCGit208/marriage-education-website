rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // These rules govern Firebase Storage only. Cloudflare R2 (upload-signer
    // worker) serves public object URLs and cannot enforce conversation
    // membership the same way. Voice notes and other CE2 media that land on
    // R2 stay world-readable if the URL is known. Do not treat R2 as locked
    // because these rules exist.

    function ce2UserDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }
    function ce2IsAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (
          firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
          (
            ce2UserDoc().data.role == 'admin' ||
            ce2UserDoc().data.role == 'Admin' ||
            ce2UserDoc().data.role == 'ADMIN' ||
            (
              ce2UserDoc().data.roles is list &&
              ce2UserDoc().data.roles.hasAny(['admin', 'Admin', 'ADMIN'])
            )
          )
        )
      );
    }
    function ce2IsDmParticipant(scopeId) {
      return firestore.exists(/databases/(default)/documents/ce2_conversations/$(scopeId)) &&
        request.auth.uid in firestore.get(/databases/(default)/documents/ce2_conversations/$(scopeId)).data.participantIds;
    }
    function ce2IsGroupMember(scopeId) {
      return firestore.exists(/databases/(default)/documents/communicationGroups/$(scopeId)/members/$(request.auth.uid));
    }
    // DMs: ce2_conversations/{id}.groups: communicationGroups/{id}/members/{uid}.
    function ce2CanAccessMediaScope(scopeId) {
      return request.auth != null && (
        ce2IsAdmin() ||
        ce2IsDmParticipant(scopeId) ||
        ce2IsGroupMember(scopeId)
      );
    }

    // Images uploaded by users
    match /images/{userId}/{imageId} {
      // Only authenticated users can read
      allow read: if request.auth != null;

      // Users can only upload to their own folder
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        // Image size limit: 5MB
        request.resource.size < 5 * 1024 * 1024 &&
        // Only allow image formats
        request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
    }

    // Video thumbnails
    match /thumbnails/{userId}/{thumbId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 2 * 1024 * 1024;
    }

    // ── CE2 / DM media (conversation-scoped) ─────────────────────
    // New objects: {prefix}/{convOrGroupId}/{uploaderId}/{fileId}
    // Legacy objects: {prefix}/{uploaderId}/{fileId} — uploader/admin only.
    // Recipients of old Firebase fallback media must re-share; we cannot
    // honestly prove "a message this caller can read points at this URL"
    // from Storage rules (no query-by-URL).

    match /dm_attachments/{scopeId}/{userId}/{fileId} {
      allow read: if ce2CanAccessMediaScope(scopeId);
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        ce2CanAccessMediaScope(scopeId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /dm_attachments/{userId}/{fileId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || ce2IsAdmin());
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /dm_videos/{scopeId}/{userId}/{fileId} {
      allow read: if ce2CanAccessMediaScope(scopeId);
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        ce2CanAccessMediaScope(scopeId) &&
        request.resource.size < 100 * 1024 * 1024 &&
        request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /dm_videos/{userId}/{fileId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || ce2IsAdmin());
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 100 * 1024 * 1024 &&
        request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /dm_audio/{scopeId}/{userId}/{fileId} {
      allow read: if ce2CanAccessMediaScope(scopeId);
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        ce2CanAccessMediaScope(scopeId) &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /dm_audio/{userId}/{fileId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || ce2IsAdmin());
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
