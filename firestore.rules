rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Courses - Public read, admin write
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Enrollments - Students can read their own, admin can read/write all
    match /enrollments/{enrollmentId} {
      allow read: if request.auth != null && 
        (request.auth.token.email == resource.data.studentEmail || 
         request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Progress tracking - Students can read/write their own
    match /progress/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reflections - Students can read/write their own
    match /reflections/{reflectionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Sales records - Admin only
    match /sales/{saleId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Ambassadors - Read own data, admin writes
    match /ambassadors/{ambassadorId} {
      allow read: if request.auth != null && 
        (request.auth.uid == ambassadorId || request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
