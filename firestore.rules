rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Courses - Public read, TESTING: allow public write for enrollment updates
    match /courses/{courseId} {
      allow read: if true;
      allow write: if true; // TESTING ONLY
    }
    
    // Enrollments - TESTING: Allow public write for testing enrollment creation
    match /enrollments/{enrollmentId} {
      allow read: if true; // TESTING ONLY
      allow write: if true; // TESTING ONLY
    }
    
    // Progress tracking - Students can read/write their own
    match /progress/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reflections - Students can read/write their own
    match /reflections/{reflectionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Sales records - Allow public read for dashboard, admin write
    match /sales/{saleId} {
      allow read: if true; // Allow ambassadors to see sales data
      allow write: if request.auth != null && request.auth.token.admin == true;
      allow create: if true; // Allow payment webhooks to create sales
    }
    
    // Ambassadors - Public can register and count, authenticated users read own data, admin full access
    match /ambassadors/{ambassadorId} {
      allow read: if true; // Allow public read for counting
      allow create: if true; // Allow public registration
      allow update: if true; // Allow ambassadors to update their own progress (using ambassadorCode)
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // DOS metrics (Phase 0) — dashboard read; client + Cloud Functions write
    match /dos_metrics/{ambassadorCode} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // DOS daily logs (Phase 2+)
    match /dos_daily_logs/{logId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // DOS subscriber pipeline (Phase 3)
    match /dos_pipeline/{recordId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    match /sbd_sales/{saleId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
      allow create: if true;
    }
    
    // School Progress - Ambassadors can read/write their own progress
    match /school_progress/{progressId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ambassadorId;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.ambassadorId;
      allow create: if true; // Allow initial creation
    }
    
    // Advocacy Training - Ambassadors can read/write their own training data
    match /advocacy_training/{trainingId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ambassadorId;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.ambassadorId;
      allow create: if true; // Allow initial creation
    }
    
    // Deployment Log - Ambassadors can create and read their own deployments
    match /deployment_log/{deploymentId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ambassadorId;
      allow create: if true; // Allow logging deployments
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // ============================================
    // NEW COLLECTIONS (RD & Payment System)
    // ============================================
    
    // Regional Directors - RD can read own data, admin can read/write all
    // TEMPORARY: Allow public read for testing dashboards
    match /regional_directors/{rdCode} {
      allow read: if true; // TEMPORARY: Allow public read for testing
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Unified payments ledger — read-only admin preview (written by backend)
    match /payments/{paymentId} {
      allow read: if true;
      allow write: if false;
    }

    // Pending Payments - Temporarily allow reads for testing (TODO: Add proper admin auth)
    match /pending_payments/{paymentRef} {
      allow read: if true; // TEMPORARY: Allow reads for testing
      allow update, delete: if true; // TEMPORARY: Allow unauthenticated updates for admin dashboard
      allow create: if true; // Allow unauthenticated payment submissions
    }
    
    // Referral Codes - Public can create and read for validation, admin can update
    match /referral_codes/{referralCode} {
      allow read: if true; // Public read for validation
      allow create: if true; // Anyone can register a code
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Admin Notifications - Allow public read/write for admin dashboard (TEMPORARY: no auth yet)
    match /admin_notifications/{notificationId} {
      allow read: if true; // TEMPORARY: Allow reads for admin dashboard
      allow write: if true; // TEMPORARY: Allow writes for marking as paid
    }

    // SBD Sales — written by Cloud Function (admin SDK), read by admin dashboard
    match /sbd_sales/{saleId} {
      allow read: if true; // Temporary: allow dashboard access until auth is enforced
      allow write: if false; // Cloud Function only
    }

    // Notifications - Allow public read for ambassador dashboard
    match /notifications/{notificationId} {
      allow read: if true; // Allow ambassadors to read notifications
      allow create: if true; // Allow system to create notifications
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Contests - Allow public read for leaderboards
    match /contests/{contestId} {
      allow read: if true; // Public read for leaderboard display
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Badges - Allow public read for achievement display
    match /badges/{badgeId} {
      allow read: if true; // Public read for badge display
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Settings - Allow public read for app configuration
    match /settings/{settingId} {
      allow read: if true; // Public read for app settings
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Announcements - Allow public read for ambassador dashboard
    match /announcements/{announcementId} {
      allow read: if true; // Public read for announcements display
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Ambassador Registrations - Allow public create for registration, admin read/write
    match /ambassador_registrations/{regId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create: if true; // Allow public registration submissions
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Chatbot Analytics - Allow public write for analytics, admin read
    match /chatbot_analytics/{analyticsId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create: if true; // Allow chatbot to log analytics
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Chatbot Learning - Allow public read/write for AI learning
    match /chatbot_learning/{learningId} {
      allow read: if true; // Allow chatbot to read learned patterns
      allow write: if true; // Allow chatbot to learn from interactions
    }
    
    // Corporate Inquiries - Allow public create, admin read/write
    match /corporate_inquiries/{inquiryId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create: if true; // Allow corporate contact form submissions
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // User Progress - Students can read/write their own progress
    match /userProgress/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow create: if true; // Allow initial progress creation
    }

    // SBD Network users — any authenticated user can read (social network: profiles visible to members)
    match /users/{userId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      // Notification settings subcollection — own user only
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Modules (course content) — authenticated users can read
    match /modules/{moduleId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // DM conversations — participants can read/write
    match /conversations/{convId} {
      allow read, write: if request.auth != null && (
        resource == null || request.auth.uid in resource.data.participantIds
      );
      match /messages/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    // Orders (SBD purchases) — user can read their own
    match /orders/{orderId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow read: if request.auth != null && request.auth.token.admin == true;
    }

    // Groups — authenticated users can read; admins write
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Boards — authenticated users can read; admins write
    match /boards/{boardId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Posts — authenticated users can read/create; author or admin can delete
    match /posts/{postId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.authorId ||
        request.auth.token.admin == true
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.authorId ||
        request.auth.token.admin == true
      );
    }

    // Match proposals (dating) — participants can read/write their own
    match /matches/{matchId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == resource.data.user1 ||
        request.auth.uid == resource.data.user2 ||
        request.auth.token.admin == true
      );
      allow create: if request.auth != null;
    }

    // Reports — authenticated users can create; admins read
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // Collections (user saved collections) — owner read/write
    match /collections/{colId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.token.admin == true;
    }

    // Stories — authenticated users can read, create their own, and manage them
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.authorId ||
        request.auth.token.admin == true
      );
    }

    // MV House — Wardrobe Guidance (system-level) — authenticated users read, admin write
    match /mv_guidance/{categoryId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Wardrobes — User wardrobe items (new path) — owner read/write
    match /wardrobes/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /items/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Extended users subcollection — wardrobes (legacy path) — owner read/write
    // This extends the users/{userId} rule defined above
    // NOTE: The parent users/{userId} rule allows authenticated read of user profiles
    // But wardrobes are private—owner only
    match /users/{userId}/wardrobes/{categoryId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Tier 1 payout audit — written by Cloud Functions only
    match /payout_events/{eventId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
