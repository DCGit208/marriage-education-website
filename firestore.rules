rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =================================================================
    // HELPER: isAdmin() — true when a logged-in Firebase Auth user
    // is present. Only admin@marriageducation.com (or any future admin
    // accounts created in Firebase Console) will pass this check.
    // The ambassador system does NOT use Firebase Auth — ambassadors
    // authenticate via an ambassador code stored in localStorage, so
    // ambassador-facing collections must allow unauthenticated reads.
    // All writes to sensitive collections are done by Cloud Functions
    // using the Admin SDK, which bypasses these rules entirely.
    // =================================================================
    function isAdmin() {
      return request.auth != null;
    }

    // =================================================================
    // PUBLIC CONTENT — Anyone can browse
    // =================================================================

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin(); // Admin and Cloud Functions
    }

    // =================================================================
    // AMBASSADOR SYSTEM — Code-based auth, no Firebase Auth
    // Reads are open so ambassadors can verify their code on login
    // and load their dashboard data. All writes come from Cloud Functions
    // (Admin SDK) after payment approval — no direct client writes needed.
    // =================================================================

    match /ambassadors/{ambassadorId} {
      allow read: if true;
      allow write: if false; // Cloud Functions only
    }

    match /senior_ambassadors/{seniorId} {
      allow read: if true;
      allow write: if false; // Cloud Functions only
    }

    match /sales/{saleId} {
      allow read: if true; // Ambassadors filter by their own code client-side
      allow write: if false; // Cloud Functions only
    }

    match /referral_codes/{referralCode} {
      allow read: if true; // Needed for code validation at registration
      allow write: if false; // Cloud Functions only
    }

    // Ambassador progress — code-based, client writes required
    match /school_progress/{progressId} {
      allow read: if true;
      allow write: if true;
    }

    match /advocacy_training/{trainingId} {
      allow read: if true;
      allow write: if true;
    }

    match /deployment_log/{deploymentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // =================================================================
    // COURSE VIEWER — Firebase Auth required (students sign in)
    // =================================================================

    match /enrollments/{enrollmentId} {
      allow read, write: if request.auth != null;
    }

    match /progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /reflections/{reflectionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    match /download_tokens/{token} {
      allow read: if true; // Anyone with the token URL can redeem it
      allow write: if false; // Cloud Functions only
    }

    // =================================================================
    // ADMIN-ONLY — Firebase Auth required (admin@marriageducation.com)
    // =================================================================

    match /pending_payments/{paymentRef} {
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
      allow create: if true; // Cloud Functions bypass rules when using Admin SDK
    }

    match /regional_directors/{rdCode} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /admin_notifications/{notificationId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // =================================================================
    // SBD NETWORK COLLECTIONS — Firebase Auth required
    // Users collection for SBD Network social platform
    // =================================================================
    
    match /users/{userId} {
      // Anyone authenticated can read all user profiles (for @ mentions, user lists)
      allow read: if request.auth != null;
      
      // Users can create and update their own document
      allow create, update: if request.auth != null && request.auth.uid == userId;
      
      // Admins can update any user (for managing groups, roles, etc.)
      allow update: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Only admins can delete users
      allow delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Groups collection (Telegram-style groups)
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Boards collection (Reddit-style boards within groups)
    match /boards/{boardId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Posts collection
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Authors can update/delete their own posts, OR admins can delete any post
      allow update, delete: if request.auth != null && 
        (request.auth.uid == resource.data.authorId || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Comments collection
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Authors can delete their own comments, OR admins can delete any comment
      allow delete: if request.auth != null && 
        (request.auth.uid == resource.data.authorId || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // =================================================================
    // CHATBOT ANALYTICS — Anonymous access for tracking
    // Public writes so chatbot can log queries without auth
    // Reads open for aggregated insights (no PII stored)
    // =================================================================

    match /chatbot_analytics/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if true; // For feedback updates
      allow delete: if isAdmin(); // Only admin can delete
    }

    match /chatbot_learning/{docId} {
      allow read: if true;
      allow write: if isAdmin(); // Only admin updates learning params
    }
  }
}
