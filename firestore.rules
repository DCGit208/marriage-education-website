rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Courses - Public read, TESTING: allow public write for enrollment updates
    match /courses/{courseId} {
      allow read: if true;
      allow write: if true; // TESTING ONLY
    }
    
    // Enrollments - TESTING: Allow public write for testing enrollment creation
    match /enrollments/{enrollmentId} {
      allow read: if true; // TESTING ONLY
      allow write: if true; // TESTING ONLY
    }
    
    // Progress tracking - Students can read/write their own
    match /progress/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reflections - Students can read/write their own
    match /reflections/{reflectionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Sales records - Admin only
    match /sales/{saleId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Ambassadors - Public can register and count, authenticated users read own data, admin full access
    match /ambassadors/{ambassadorId} {
      allow read: if true; // Allow public read for counting
      allow create: if true; // Allow public registration
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // ============================================
    // NEW COLLECTIONS (RD & Payment System)
    // ============================================
    
    // Regional Directors - RD can read own data, admin can read/write all
    // TEMPORARY: Allow public read for testing dashboards
    match /regional_directors/{rdCode} {
      allow read: if true; // TEMPORARY: Allow public read for testing
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Pending Payments - Temporarily allow reads for testing (TODO: Add proper admin auth)
    match /pending_payments/{paymentRef} {
      allow read: if true; // TEMPORARY: Allow reads for testing
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
      allow create: if true; // Allow unauthenticated payment submissions
    }
    
    // Referral Codes - Public can create and read for validation, admin can update
    match /referral_codes/{referralCode} {
      allow read: if true; // Public read for validation
      allow create: if true; // Anyone can register a code
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
