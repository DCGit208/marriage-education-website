rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // eBooks - Generate signed URLs from Cloud Functions only
    match /ebooks/{ebookFile} {
      allow read: if false; // No direct public access
      allow write: if false; // Upload only via admin
    }

    // SBD Network CE2 / DM media (Firebase Storage fallback when R2 is blocked)
    match /dm_attachments/{userId}/{fileId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /dm_videos/{userId}/{fileId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 100 * 1024 * 1024 &&
        request.resource.contentType.matches('video/.*');
    }

    match /dm_audio/{userId}/{fileId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
    }
  }
}
