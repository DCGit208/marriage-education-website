rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // eBooks - Generate signed URLs from Cloud Functions only
    match /ebooks/{ebookFile} {
      allow read: if false; // No direct public access
      allow write: if false; // Upload only via admin
    }

    // SBD Network CE2 / DM media (Firebase Storage fallback when R2 is blocked).
    // Same layout and membership checks as sbd-network/storage.rules — keep in
    // sync. These rules do not apply to public Cloudflare R2 object URLs.
    function ce2UserDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }
    function ce2IsAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (
          firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
          (
            ce2UserDoc().data.role == 'admin' ||
            ce2UserDoc().data.role == 'Admin' ||
            ce2UserDoc().data.role == 'ADMIN' ||
            (
              ce2UserDoc().data.roles is list &&
              ce2UserDoc().data.roles.hasAny(['admin', 'Admin', 'ADMIN'])
            )
          )
        )
      );
    }
    function ce2IsDmParticipant(scopeId) {
      return firestore.exists(/databases/(default)/documents/ce2_conversations/$(scopeId)) &&
        request.auth.uid in firestore.get(/databases/(default)/documents/ce2_conversations/$(scopeId)).data.participantIds;
    }
    function ce2IsGroupMember(scopeId) {
      return firestore.exists(/databases/(default)/documents/communicationGroups/$(scopeId)/members/$(request.auth.uid));
    }
    function ce2CanAccessMediaScope(scopeId) {
      return request.auth != null && (
        ce2IsAdmin() ||
        ce2IsDmParticipant(scopeId) ||
        ce2IsGroupMember(scopeId)
      );
    }

    match /dm_attachments/{scopeId}/{userId}/{fileId} {
      allow read: if ce2CanAccessMediaScope(scopeId);
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        ce2CanAccessMediaScope(scopeId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /dm_attachments/{userId}/{fileId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || ce2IsAdmin());
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /dm_videos/{scopeId}/{userId}/{fileId} {
      allow read: if ce2CanAccessMediaScope(scopeId);
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        ce2CanAccessMediaScope(scopeId) &&
        request.resource.size < 100 * 1024 * 1024 &&
        request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /dm_videos/{userId}/{fileId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || ce2IsAdmin());
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 100 * 1024 * 1024 &&
        request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /dm_audio/{scopeId}/{userId}/{fileId} {
      allow read: if ce2CanAccessMediaScope(scopeId);
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        ce2CanAccessMediaScope(scopeId) &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /dm_audio/{userId}/{fileId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || ce2IsAdmin());
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
